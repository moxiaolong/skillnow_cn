# Public site URL (used for canonical URLs / sitemap)
NEXT_PUBLIC_SITE_URL=https://skillnow.cn

# PostHog (optional; leave empty to disable analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The following are EdgeOne Pages Functions environment variables.
# Set them in the EdgeOne console, not in this file:
# REACTIONS_KV          -> KV namespace binding name
# REACTIONS_HMAC_SECRET -> secret used to hash IP + UA for daily vote limits
# REACTIONS_CLEANUP_SECRET -> secret used by the daily cleanup workflow
